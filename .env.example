# ---- Base de datos (PostgreSQL / Supabase: Settings > Database > Connection string) ----
DATABASE_URL=postgresql://USUARIO:CLAVE@HOST:5432/postgres
# Pon "true" si el proveedor exige SSL (Supabase lo exige)
DATABASE_SSL=true
# Solo para pruebas automatizadas (base de datos desechable, NUNCA producción)
TEST_DATABASE_URL=postgresql://postgres@localhost:5432/rifa_test

# ---- Administrador (autenticación real, sin valores por defecto) ----
ADMIN_EMAIL=
# Generar con: npm run admin:hash -- "tu-contraseña-larga"
ADMIN_PASSWORD_HASH=
# Cadena aleatoria de 32+ caracteres: openssl rand -hex 32
SESSION_SECRET=

# ---- Datos de la rifa (dejar vacío = "PENDIENTE" en pantalla) ----
RAFFLE_TICKET_PRICE=            # pesos enteros por número. Vacío = reservas deshabilitadas
RAFFLE_CURRENCY=COP
RAFFLE_DRAW_DATE=               # texto libre, p. ej. "24 de diciembre de 2026"
RAFFLE_PRIZES=                  # premios separados por | (solo premios oficiales)
RAFFLE_TERMS=                   # condiciones separadas por | (si se define, se exige aceptarlas)
RAFFLE_PAYMENT_INSTRUCTIONS=    # método de pago oficial (se muestra tras reservar)
COMPANY_LEGAL_INFO=             # razón social / NIT / datos legales
WHATSAPP_NUMBER=                # solo dígitos con indicativo de país, sin + (p. ej. 57XXXXXXXXXX)

# ---- Comportamiento ----
RESERVATION_TTL_MINUTES=60
MAX_NUMBERS_PER_RESERVATION=20
